 inline constexpr int kTargetSmCount = 82; // NVIDIA GeForce RTX 3090
+#elif defined(NINFER_SM120)
+inline constexpr int kTargetSmCount = 36; // NVIDIA GeForce RTX 5060 Ti (Blackwell)
