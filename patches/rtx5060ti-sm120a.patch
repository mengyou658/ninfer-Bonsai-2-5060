diff --git a/CMakeLists.txt b/CMakeLists.txt
index 427804a..01b4e22 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -35,6 +35,10 @@ endif()
 if(CMAKE_CUDA_ARCHITECTURES MATCHES "89")
   add_compile_definitions(NINFER_SM89=1)
 endif()
+# sm_120a (Blackwell): warp-specialized TMA kernels; device.h needs compile-time SM count.
+if(CMAKE_CUDA_ARCHITECTURES MATCHES "^120")
+  add_compile_definitions(NINFER_SM120=1)
+endif()
 
 if(MSVC)
   add_compile_definitions(NOMINMAX UTF8PROC_STATIC)
@@ -56,9 +60,9 @@ if(CMAKE_GENERATOR MATCHES "Ninja")
   set(CMAKE_JOB_POOL_LINK cuda_link)
 endif()
 
-if(CMAKE_CUDA_COMPILER_VERSION VERSION_LESS 13.1)
+if(CMAKE_CUDA_COMPILER_VERSION VERSION_LESS 13.0)
   message(FATAL_ERROR
-    "NInfer requires CUDA 13.1 or newer; found CUDA compiler "
+    "NInfer requires CUDA 13.0 or newer; found CUDA compiler "
     "${CMAKE_CUDA_COMPILER_VERSION}")
 endif()
 
diff --git a/src/core/device.h b/src/core/device.h
